# Base URL of the Eve proxy. useEveAgent appends `/eve/v1` to this, so point it
# at the app-owned proxy path of your agent-eve deployment, e.g.:
#   https://your-deploy.vercel.app/api
EXPO_PUBLIC_EVE_API_URL=

# Service-principal bearer token. When the deployment has EVE_API_KEY set, the
# proxy rejects requests without `Authorization: Bearer <key>`.
# NOTE: shipping a shared service key in a client app is insecure. For
# production, exchange a per-user session token (e.g. via the Google OAuth
# flow the web app uses) instead of a static EVE_API_KEY.
EXPO_PUBLIC_EVE_API_KEY=
